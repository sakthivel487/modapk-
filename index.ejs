        <a href="/terms">Terms of Use</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
      </div>
      <div class="footer-links-group">
        <h4>Categories</h4>
        <a href="/category/action">Action Games</a>
        <a href="/category/rpg">RPG Games</a>
        <a href="/category/social">Social Apps</a>
        <a href="/category/music">Music Apps</a>
        <a href="/category/tools">Tools</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2025 ModVault. All rights reserved. Files hosted on third-party servers. <a href="/disclaimer">Disclaimer</a></p>
    </div>
  </div>
</footer>



  
  
  
  <%- include('partials/firebase') %>
  <%- include('partials/cookie_banner') %>
  <%- include('partials/auth_modals') %>
  <script src="/js/auth.js"></script>
</body>
</html>
